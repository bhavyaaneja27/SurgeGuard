# SurgeGuard Monorepo Environment Configuration (Example)
# Copy this file to backend/.env and frontend/.env as needed.
# DO NOT commit real secrets or credentials to source control.

# --- Backend Configuration ---
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Database URL (Optional - leave blank for local non-blocking demo mode)
DATABASE_URL=
USE_LOCAL_DEMO_DB=true

# Model & Simulation
DEFAULT_RANDOM_SEED=42
MODEL_ARTIFACTS_DIR=app/models/artifacts

# Optional Copilot Adapter (Gemini API Key - must remain server-side only)
GEMINI_API_KEY=

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
