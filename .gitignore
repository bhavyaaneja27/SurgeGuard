# SurgeGuard Monorepo .gitignore

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
.venv/
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend dependencies & build outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm/
.eslintcache
*.tsbuildinfo

# Environment variables & secrets (NEVER commit secrets)
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# ML Model artifacts & large binaries
backend/app/models/artifacts/*.pkl
backend/app/models/artifacts/*.joblib
backend/app/models/artifacts/*.onnx
backend/app/models/artifacts/*.pt
backend/app/models/artifacts/*.bin
!backend/app/models/artifacts/.gitkeep

# Data files & generated outputs
data/raw/*
data/processed/*
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep
!data/README.md

# Operating System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
