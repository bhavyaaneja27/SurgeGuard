# SurgeGuard Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true

# API Server Configuration
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Database URL (Optional: Leave empty for local demo mode without external DB)
DATABASE_URL=
USE_LOCAL_DEMO_DB=true

# ML Model Parameters
DEFAULT_RANDOM_SEED=42
MODEL_ARTIFACTS_DIR=app/models/artifacts

# Optional Copilot (Gemini API key; keep server-side only; never expose in frontend)
GEMINI_API_KEY=
